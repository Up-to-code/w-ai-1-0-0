{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shopify/flash-list": ["./types/flash-list-stub.d.ts"],
      "expo-notifications": ["./types/expo-notifications-stub.d.ts"],
      "expo-asset": ["./types/expo-asset-stub.d.ts"]
    }
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "hooks/**/*",
    "contexts/**/*",
    "lib/**/*",
    "types/**/*",
    "*.ts",
    "*.tsx",
    "App.tsx"
  ],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}
